{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "es2024": true,
    "node": true
  },
  "ignorePatterns": ["**/dist/**"],
  "overrides": [
    {
      "files": ["apps/web/src/**"],
      "plugins": ["react", "jsx-a11y"],
      "env": {
        "browser": true
      }
    }
  ]
}
